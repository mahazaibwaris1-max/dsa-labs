#include <iostream>
using namespace std;

class List {
protected:
    int* arr;
    int maxSize;
    int currentSize;

public:

    List(int size = 10, int current = 0) {
        maxSize = size;
        currentSize = current;
        arr = new int[maxSize];
    }


    List(const List& other) {
        maxSize = other.maxSize;
        currentSize = other.currentSize;

        arr = new int[maxSize];

        for (int i = 0; i < currentSize; i++) {
            arr[i] = other.arr[i];
        }
    }

    
    virtual void addElementAtFirstIndex(int type) = 0;

    
    virtual void addElementAtLastIndex(int type) = 0;

    virtual void removeElementFromEnd() = 0;

    
    virtual void removeElementFromStart() = 0;

  
    virtual ~List() {
        delete[] arr;
    }
};

int main() {
    cout << "Abstract List class created successfully." << endl;
    return 0;
}
